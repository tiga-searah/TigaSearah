{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["SITE_URL"],
			"outputs": ["dist/**", ".output/**"]
		},
		"@tiga-searah/api#build": {
			"dependsOn": ["^build", "@tiga-searah/web#build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"format": {}
	}
}
